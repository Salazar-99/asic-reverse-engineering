{
  "name": "ASIC reverse engineering (SKY130)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PDK": "sky130A",
    "PDK_ROOT": "/opt/pdk/share/pdk",
    "SKY130_HD_ROOT": "/opt/skywater-pdk-libs-sky130_fd_sc_hd",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venvs/asic-reverse-engineering"
  },
  "postCreateCommand": "uv sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mshr-h.veriloghdl"
      ]
    }
  }
}
